{
  "openapi": "3.0.3",
  "info": {
    "title": "Intellmeet Backend API",
    "description": "REST API documentation for the Intellmeet backend.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health endpoints"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Basic health check",
        "description": "Returns a lightweight health response for the service.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/detailed": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Detailed health check",
        "description": "Returns service health with runtime and system details.",
        "responses": {
          "200": {
            "description": "Detailed service health information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedHealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BasicHealthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Service is healthy"
          },
          "statusCode": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "healthy"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "example": "2026-04-24T12:00:00.000Z"
              },
              "uptime": {
                "type": "number",
                "example": 42.8
              }
            },
            "required": [
              "status",
              "timestamp",
              "uptime"
            ]
          }
        },
        "required": [
          "success",
          "message",
          "statusCode",
          "data"
        ]
      },
      "DetailedHealthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Service is healthy"
          },
          "statusCode": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "healthy"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "example": "2026-04-24T12:00:00.000Z"
              },
              "uptime": {
                "type": "number",
                "example": 42.8
              },
              "environment": {
                "type": "string",
                "example": "development"
              },
              "version": {
                "type": "string",
                "example": "1.0.0"
              },
              "memory": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "number",
                    "example": 32.5
                  },
                  "total": {
                    "type": "number",
                    "example": 64.2
                  },
                  "unit": {
                    "type": "string",
                    "example": "MB"
                  }
                },
                "required": [
                  "used",
                  "total",
                  "unit"
                ]
              },
              "cpu": {
                "type": "object",
                "properties": {
                  "usage": {
                    "type": "object",
                    "properties": {
                      "user": {
                        "type": "integer",
                        "example": 120000
                      },
                      "system": {
                        "type": "integer",
                        "example": 45000
                      }
                    },
                    "required": [
                      "user",
                      "system"
                    ]
                  }
                },
                "required": [
                  "usage"
                ]
              }
            },
            "required": [
              "status",
              "timestamp",
              "uptime",
              "environment",
              "version",
              "memory",
              "cpu"
            ]
          }
        },
        "required": [
          "success",
          "message",
          "statusCode",
          "data"
        ]
      }
    }
  }
}
